# ================================================================
#  traffic_marketing — 환경변수 설정 파일
#
#  사용법:
#    1. 이 파일을 복사해서 .env 로 저장합니다.
#       cp .env.example .env
#    2. 아래 값들을 실제 값으로 채워 넣습니다.
#    3. .env 파일은 절대 Git에 커밋하지 마세요. (secrets 포함)
# ================================================================


# ── 텔레그램 알림 ──────────────────────────────────────────────
# 텔레그램 BotFather 에서 발급받은 봇 토큰과 알림 받을 챗 ID
TELEGRAM_BOT_TOKEN=8823068824:AAGGEZlkjq_FIy7C8E1nULLJqBU-dQ0M5o8
TELEGRAM_CHAT_ID=6554024624


# ── 스케줄러 실행 시각 (KST) ───────────────────────────────────
# python scheduler.py --schedule 실행 시 이 시각에 자동 리포트 발송
REPORT_HOUR=8
REPORT_MINUTE=0


# ── 트래픽 도매 API (MVP 1차 비활성) ───────────────────────────
# [트래픽 주입] 탭이 비활성화되어 있어 현재는 사용하지 않습니다.
# 추후 재활성화 시 실제 도매처 API 정보로 교체하세요.
TRAFFIC_API_BASE_URL=https://api.your-traffic-provider.com/v1
TRAFFIC_API_KEY=your-secret-api-key-here
TRAFFIC_API_TIMEOUT=15
TRAFFIC_API_RETRIES=3
TRAFFIC_API_STUB=true
